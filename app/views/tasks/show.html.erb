
<h1 class="alert alert-warning d-flex "><%= @task.title %></h1>
<h2 class="p-3 "><%= @task.details %></h2>
<h2 class="p-3 "> This task is <%= @task.completed ? "completed! 😎" : "not completed 🤕" %></h2>
<br>
<br>

<div class="btn btn-warning"> <%= link_to "Back to list", tasks_path%> </div>
<button type="button" class="btn btn-secondary"><%= link_to "Edit task", edit_task_path(@task)%></button>
