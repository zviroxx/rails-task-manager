<h1>All the tasks</h1>

<ul>
    <% @tasks.each do |task|%>
      <li class="p-3"><h3 class="alert alert-warning"><%= task.title.capitalize%></h3> <div class="btn btn-warning"><%= link_to "View more", task_path(task)%></div> <div class="btn btn-danger"><%= link_to "Delete", task_path(task), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}%></div></li>
    <% end %>
</ul>

  <h1><button type="button" class="p-3 btn btn-success"><%= link_to "new task", new_task_path%></button></h1>
